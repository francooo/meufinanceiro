DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
PORT=8787

# Autenticação Google (Client ID do OAuth criado no Google Cloud Console)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Todos os Client IDs aceitos, separados por vírgula — um por plataforma
# (web, android, ios). O servidor valida o id_token contra qualquer um deles.
# Se não for definida, cai no GOOGLE_CLIENT_ID acima.
GOOGLE_CLIENT_IDS=web.apps.googleusercontent.com,android.apps.googleusercontent.com
# Mesmo valor acima, exposto ao front-end pelo Vite
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Quem pode entrar. VAZIO (ou ausente) = qualquer conta Google com e-mail
# verificado; cada conta vê só as próprias finanças. Preencha (separado por
# vírgula) só se quiser fechar o app para uma lista de contas.
ALLOWED_EMAILS=
# Dono dos dados que já existiam quando o app era de uma pessoa só. Lido uma vez
# pela migração para dar dono às linhas antigas (se vazio, usa ALLOWED_EMAIL).
LEGACY_OWNER_EMAIL=voce@gmail.com
# Origem do site, para o CORS (separe por vírgula se houver mais de uma).
APP_ORIGIN=https://meufinanceiro-v2.vercel.app
# String aleatória usada para assinar o cookie de sessão (gere uma só vez e mantenha em segredo)
SESSION_SECRET=
