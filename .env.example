DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
PORT=8787

# Autenticação Google (Client ID do OAuth criado no Google Cloud Console)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Todos os Client IDs aceitos, separados por vírgula — um por plataforma
# (web, android, ios). O servidor valida o id_token contra qualquer um deles.
# Se não for definida, cai no GOOGLE_CLIENT_ID acima.
GOOGLE_CLIENT_IDS=web.apps.googleusercontent.com,android.apps.googleusercontent.com
# Mesmo valor acima, exposto ao front-end pelo Vite
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Único e-mail Google autorizado a entrar no app
ALLOWED_EMAIL=voce@gmail.com
# String aleatória usada para assinar o cookie de sessão (gere uma só vez e mantenha em segredo)
SESSION_SECRET=
